---
import Masthead from "../components/Masthead.astro";
import "../styles/global.css";
import "../styles/harada-method.css";

const title = "Free Harada Inspired Worksheet — One Goal, Eight Spokes | SheisFEM";
const description =
  "Build your Harada wheel with a free one-goal, eight-spokes planning worksheet, delivered straight to your inbox.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const imageUrl = new URL("/assets/harada-wheel-preview.png", Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="p:domain_verify" content="34dcd05c9209fdc7d3074ae2351b0b1a" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/assets/fem-logo.png" />
    <link rel="apple-touch-icon" href="/assets/fem-logo.png" />
    <meta property="og:site_name" content="SheisFEM" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@300;400;500;600&family=Caveat:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="harada-page">
    <Masthead active="harada-method" />
    <main class="harada-main">
      <section class="harada-hero" aria-labelledby="harada-title">
        <div class="harada-copy">
          <p class="harada-kicker">Free goal-planning worksheet</p>
          <h1 id="harada-title">
            One goal.<br />Eight spokes.<br /><em>A plan you can follow.</em>
          </h1>
          <p class="harada-lede">
            Turn the life you keep picturing into one clear goal and the eight areas that will
            help you reach it. This free worksheet inspired by the Harada Method gives you a simple place to map
            it all out.
          </p>

          <ul class="harada-benefits" aria-label="What the worksheet helps you do">
            <li>Name the goal at the center of your wheel</li>
            <li>Choose the eight supporting areas that matter to you</li>
            <li>Turn each spoke into small, repeatable actions</li>
          </ul>

          <figure class="harada-preview">
            <div class="harada-preview-frame">
              <img
                src="/assets/harada-wheel-preview.png"
                alt="Inside the worksheet: an eight-spoke Harada wheel surrounding one central goal"
                width="1200"
                height="898"
                loading="eager"
                fetchpriority="high"
              />
              <span class="harada-preview-badge">4-page printable PDF</span>
            </div>
            <figcaption>A peek at what’s waiting in your inbox.</figcaption>
          </figure>
        </div>

        <div class="harada-offer">
          <div class="harada-wheel" aria-hidden="true">
            <div class="harada-wheel-ring"></div>
            <div class="harada-wheel-lines"></div>
            <span class="harada-wheel-center">your<br />goal</span>
          </div>

          <div class="harada-form-card">
            <p class="harada-form-kicker">Start with the worksheet</p>
            <h2>Build Your <span>SheisFEM Goal Wheel</span></h2>
            <p class="harada-form-copy">
              Set your goal in motion—one spoke, one action, one step at a time. Enter your email
              and you'll get the free worksheet straight to your inbox.
            </p>

            <form class="harada-native-form" data-harada-signup-form>
              <label class="harada-email-label" for="harada-email">Email address</label>
              <input
                id="harada-email"
                class="harada-email-input"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="your@email.com"
              />
              <button class="harada-submit" type="submit">
                <span data-harada-button-text>Get the worksheet</span>
              </button>
              <p class="harada-form-status" aria-live="polite" data-harada-status></p>
            </form>
            <p class="harada-privacy">Free download. No spam. Unsubscribe anytime.</p>
            <a
              class="harada-success-home"
              href="/blog/the-harada-method-one-goal-eight-spokes-a-whole-life?ref=subscribed"
              data-harada-success-cta
              hidden>Read the full story behind the method →</a
            >
          </div>
        </div>
      </section>

      <footer class="harada-footer">
        <span>She Learns More</span>
        <span aria-hidden="true">•</span>
        <span>sheisfem.com</span>
      </footer>
    </main>

    <script>
      import { getHaradaSuccessCta } from "../lib/haradaReferral";

      const burger = document.getElementById("navBurger");
      const links = document.getElementById("navLinks");

      burger?.addEventListener("click", () => {
        links?.classList.toggle("open");
      });

      document.addEventListener("click", (event) => {
        if (!links?.classList.contains("open")) return;
        if (!(event.target instanceof Node)) return;
        if (!links.contains(event.target) && !burger?.contains(event.target)) {
          links.classList.remove("open");
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") links?.classList.remove("open");
      });

      links?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => links.classList.remove("open"));
      });

      const signupForm = document.querySelector("[data-harada-signup-form]");
      const successCta = document.querySelector("[data-harada-success-cta]");
      const referral = new URLSearchParams(window.location.search).get("ref");
      const followUpCta = getHaradaSuccessCta(referral);

      if (successCta instanceof HTMLAnchorElement) {
        successCta.href = followUpCta.href;
        successCta.textContent = followUpCta.label;
      }

      const setSignupStatus = (message: string, state: string) => {
        const status = signupForm?.querySelector("[data-harada-status]");
        if (!(status instanceof HTMLElement)) return;

        status.textContent = message;
        status.dataset.state = state;
      };

      signupForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!(signupForm instanceof HTMLFormElement) || !signupForm.reportValidity()) return;

        const submitButton = signupForm.querySelector('button[type="submit"]');
        const buttonText = signupForm.querySelector("[data-harada-button-text]");
        const email = new FormData(signupForm).get("email");

        if (email instanceof File) return;

        submitButton?.setAttribute("disabled", "");
        if (buttonText) buttonText.textContent = "Sending...";
        setSignupStatus("Sending your worksheet...", "loading");

        try {
          const response = await fetch("/api/harada-signup", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          });
          const data = await response.json().catch(() => ({}));

          if (!response.ok || data.ok !== true) {
            throw new Error(data.error || "Something went wrong. Please try again.");
          }

          signupForm.querySelector(".harada-email-label")?.setAttribute("hidden", "");
          signupForm.querySelector(".harada-email-input")?.setAttribute("hidden", "");
          submitButton?.setAttribute("hidden", "");
          setSignupStatus("You're almost there—check your inbox to confirm and download your worksheet.", "success");
          if (successCta instanceof HTMLElement) successCta.hidden = false;
        } catch (error) {
          setSignupStatus(
            error instanceof Error ? error.message : "Something went wrong. Please try again.",
            "error"
          );
        } finally {
          submitButton?.removeAttribute("disabled");
          if (buttonText) buttonText.textContent = "Get the worksheet";
        }
      });
    </script>
  </body>
</html>
