---
import { formatEntryDate, type Pillar, pillarLabels } from "../lib/blogIndex";
import { getCalendarIssueWeek } from "../lib/issueWeek";
import PillarIcon from "./PillarIcon.astro";

interface Props {
  slug: string;
  entry: {
    title: string;
    pillars: readonly Pillar[];
    publishedDate: string | null;
    excerpt?: string;
  };
  isLatest?: boolean;
  isScheduled?: boolean;
}

const { slug, entry, isLatest = false, isScheduled = false } = Astro.props;
const date = formatEntryDate(entry.publishedDate);
const publishedDateParts = entry.publishedDate?.split("-").map(Number);
const issueWeek = publishedDateParts
  ? getCalendarIssueWeek(
      new Date(publishedDateParts[0], publishedDateParts[1] - 1, publishedDateParts[2])
    )
  : null;
const entryPillars = entry.pillars;
const pillarLabelList = entryPillars.map((pillar) => pillarLabels[pillar] ?? pillar);
---

<a
  href={`/blog/${slug}`}
  class="entry"
  data-entry
  data-pillars={entryPillars.join(" ")}
  data-date={entry.publishedDate}
  data-title={entry.title}
  data-excerpt={entry.excerpt ?? ""}
  data-search={`${entry.title} ${entry.excerpt ?? ""} ${pillarLabelList.join(" ")}`.toLowerCase()}
>
  {(isLatest || isScheduled) && (
    <span class="pin" data-pin>{isScheduled ? "Scheduled" : "Latest"}</span>
  )}
  <div class="date-rail">
    <div class="d-script">{date.monthDay}</div>
    <div class="d-year">{date.year}</div>
    <div class="d-issue">
      {issueWeek && (
        <div class="d-issue-no">issue no. {String(issueWeek.week).padStart(2, "0")}</div>
      )}
    </div>
  </div>
  <div class="entry-main">
    <div class="e-filed-list" aria-label={`Filed under ${pillarLabelList.join(", ")}`}>
      {entryPillars.map((pillar) => (
        <span class="e-filed">
          <PillarIcon pillar={pillar} />
          {pillarLabels[pillar] ?? pillar}
        </span>
      ))}
    </div>
    <h2 data-title-target>{entry.title}</h2>
    {entry.excerpt && <p class="e-excerpt" data-excerpt-target>{entry.excerpt}</p>}
    <div class="e-foot">
      <span class="open">
        Read
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </div>
  </div>
</a>
